# vscode
.vscode 

# Intellij
*.iml
.idea

# my own stuff...
video-scripts

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# Bundled test output (npm test)
.test-out

# obsidian
data.json

# Local recovery snapshots created by the plugin
backups/

# Icon packs downloaded at runtime — served from the packs-v2 tag, never committed
icon-packs/

# Translations downloaded at runtime — served from the plugin's own release tag,
# never committed. The committed sources they are generated from live in
# locales/, which is a different name on purpose: in development the repository
# IS the plugin folder, so one name would have the cache overwrite the sources.
translations/

# Material Symbols webfonts cached at runtime — fetched from fonts.gstatic.com on
# first use of the picker's Material grid. A cache, never a dependency: Google
# reissues the file whenever the icon set changes, so a pinned copy would go stale.
icon-fonts/

# local agent state
.serena/
graphify-out/

# .claude is local-only, except the skills below — the release process and
# the deep-dive architecture skills split out of CLAUDE.md — which belong
# in version control.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release/
!.claude/skills/tabler-outline-stroke/
!.claude/skills/user-image-icons/
!.claude/skills/callout-color-nesting/
!.claude/skills/callout-metadata-pipe/

# Exclude macOS Finder (System Explorer) View States
.DS_Store
